# Python
__pycache__/
*.py[cod]

# PyInstaller 建置產物
build/
dist/
*.spec

# 開發者模式插件,只存在本機
dev/

# 發布產物:exe 改放 GitHub Release,不進版本控制
PDF Studio/

# 執行時才產生的東西
output/
error.log

# 使用者同意後才下載的外部元件與模型
bin/
models/
fonts/

# 使用者存的簽名屬於個人資料
signatures/

# 測試或處理中的 PDF 屬於個人檔案
*.pdf

# 測試用的檔案(使用者放的樣品、測試產生的檔案),不進版本控制
testfile/

# 使用者的個人設定(程式會自動建立預設值)
config.json

# images 只追蹤介面素材,使用者自己放的背景圖不納入
images/*
!images/app_icon.png
!images/app_icon.ico
!images/ui_*.png
