# Python
__pycache__/
*.py[cod]

# PyInstaller 建置產物
build/
dist/
*.spec

# 開發者模式插件,只存在本機
dev/

# 發布產物:exe 改放 GitHub Release,不進版本控制
PDF Studio/

# 執行時才產生的東西
output/
error.log
subtitle_error.log

# 使用者同意後才下載的外部元件與模型
bin/
models/

# 畫到一半的電路圖屬於個人資料
circuits/

# 測試或處理中的 PDF 屬於個人檔案
*.pdf

# 測試用的檔案(使用者放的樣品、測試產生的檔案),不進版本控制
testfile/

# setting 是使用者的個人設定(config.json、簽名、字型、專有名詞與修正錯字的設定檔等,程式會自動建立),
# 只追蹤 images 裡的介面素材,使用者自己放的背景圖不納入
setting/*
!setting/images/
setting/images/*
!setting/images/app_icon.png
!setting/images/app_icon.ico
!setting/images/ui_*.png

# 舊版(v1.18.0 以前)放在程式資料夾的設定,啟動時會搬進 setting
/config.json
/config.bak*.json
/images/
/fonts/
/signatures/

# 擴充模組存的資料、更新時的暫存
mods_data/
update/
